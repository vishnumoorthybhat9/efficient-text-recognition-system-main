# --- Generated data & artifacts -------------------------------------------
data/uploads/
data/user_images/
artifacts/checkpoints/
artifacts/logs/
artifacts/reports/
artifacts/figures/
artifacts/*.db
artifacts/*.db-journal
# SQLite write-ahead log and shared-memory files: transient, and committing
# them would publish a half-written database.
artifacts/*.db-wal
artifacts/*.db-shm
*.log

