*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.zip
*.tar
*.tar.gz
*.7z

# --- Dataset images ---------------------------------------------------------
# All images are inside EFFICIENT/data.zip, which is attached to a GitHub
# Release (it is over the 100 MB file limit). Labels/CSVs are still committed.
EFFICIENT/data.zip
EFFICIENT/data/**/*.jpg
EFFICIENT/data/**/*.jpeg
EFFICIENT/data/**/*.png
EFFICIENT/data/**/*.bmp
EFFICIENT/data/**/*.tif
EFFICIENT/data/**/*.tiff
EFFICIENT/data/**/*.webp
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
data/**/*.tif
data/**/*.tiff
data/**/*.webp

