# them would publish a half-written database.
artifacts/*.db-wal
artifacts/*.db-shm
*.log

# --- Model weights & archives (over GitHub's 100 MB file limit) ------------
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.zip
*.tar
*.tar.gz
*.7z

# --- EFFICIENT dataset: the unzipped data/ folder IS committed; only the ----
# --- 1.37 GB zip is left out (GitHub rejects files over 100 MB) ------------
EFFICIENT/data.zip

